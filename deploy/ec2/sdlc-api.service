[Unit]
Description=SDLC Runbook API and web UI
After=network.target sdlc-local-services.service
Wants=sdlc-local-services.service

[Service]
User=__USER__
WorkingDirectory=/opt/sdlc-runbook
ExecStart=/opt/sdlc-runbook/.venv/bin/python -m uvicorn sdlc_runbook.interfaces.api:create_app --factory --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
