# Copy this file to .env (git-ignored) and fill in your values.
# Real environment variables override anything in .env. Never commit or share .env.

# ---- Model: Amazon Bedrock ----
LLM_PROVIDER=bedrock
# No API key: credentials come from the AWS chain (EC2 instance role, `aws sso login` or `aws configure`).
AWS_REGION=us-east-1
# On-demand model id, or its inference profile id (e.g. us.amazon.nova-lite-v1:0) if the
# model is only offered that way in your region.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Per-call output cap; Amazon Nova models allow up to 5000 output tokens.
BEDROCK_MAX_OUTPUT_TOKENS=5000

# ---- Where runs (conversations) are saved ----
# memory = lost when the app restarts (fine locally); dynamodb = saved in an Amazon DynamoDB table
RUN_STORE=memory
DYNAMODB_TABLE=sdlc-runbook-runs

# ---- Optional per-stage model override (Bedrock model id) ----
CLASSIFICATION_DEPLOYMENT=
REQUIREMENTS_DEPLOYMENT=
DESIGN_DEPLOYMENT=
TASKS_DEPLOYMENT=
SPECIFICATION_DEPLOYMENT=

# ---- App sign-in ----
# yes -> mock sign-in with a role picker (local development / POC only).
# anything else -> Microsoft Entra ID; set the ENTRA_* values below.
MOCK_AUTH=yes
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_API_SCOPE=

# ---- External APIs ----
# Default to the free custom local services (python -m uvicorn local_services.app:app --port 8001).
CONTENT_SAFETY_ENDPOINT=http://127.0.0.1:8001
CONTENT_SAFETY_KEY=
LANGUAGE_ENDPOINT=http://127.0.0.1:8001
LANGUAGE_KEY=
SEARCH_ENDPOINT=http://127.0.0.1:8001
SEARCH_KEY=
SEARCH_INDEX=engineering-standards
DEVOPS_ORG_URL=http://127.0.0.1:8001/devops/demo-org
DEVOPS_PROJECT=sdlc-runbook
DEVOPS_PAT=
